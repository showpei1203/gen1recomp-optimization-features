+void close_controller(const char* reason) {
+    if (!g_controller) return;
+    const char* name = SDL_GameControllerName(g_controller);
+    std::cerr << "M6_CONTROLLER_CLOSE frame=" << g_frame
+              << " instance=" << g_controller_instance
+              << " name=" << (name ? name : "unknown")
+              << " reason=" << (reason ? reason : "unknown")
+              << " R-SD-127=1\n";
+    SDL_GameControllerClose(g_controller);
+    g_controller = nullptr;
+    g_controller_instance = -1;
+}
+
+void try_open_controller(int preferred_index, const char* reason) {
+    if (g_controller) return;
+    const int total = SDL_NumJoysticks();
+    auto attempt = [&](int i) -> bool {
+        if (i < 0 || i >= total || !SDL_IsGameController(i)) return false;
+        SDL_GameController* c = SDL_GameControllerOpen(i);
+        if (!c) return false;
+        g_controller = c;
+        SDL_Joystick* joy = SDL_GameControllerGetJoystick(c);
+        g_controller_instance = joy ? SDL_JoystickInstanceID(joy) : -1;
+        const char* name = SDL_GameControllerName(c);
+        std::cerr << "M6_CONTROLLER_OPEN frame=" << g_frame
+                  << " device_index=" << i
+                  << " instance=" << g_controller_instance
+                  << " name=" << (name ? name : "unknown")
+                  << " reason=" << (reason ? reason : "unknown")
+                  << " mapping=direct_ab_lr_start_select_plus_left_analog_dpad"
+                  << " R-SD-126=1 R-SD-128=1 R-SD-129=1\n";
+        return true;
+    };
+    if (preferred_index >= 0 && attempt(preferred_index)) return;
+    for (int i = 0; i < total; ++i) {
+        if (i == preferred_index) continue;
+        if (attempt(i)) return;
+    }
+}
+
+bool controller_button(SDL_GameControllerButton button) {
+    return g_controller && SDL_GameControllerGetButton(g_controller, button) != 0;
+}
